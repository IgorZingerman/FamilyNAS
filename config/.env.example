# Copy to .env and fill in your own values. Never commit the real .env.

UPLOAD_LOCATION=/tank/apps/immich/data
DB_DATA_LOCATION=/var/lib/immich/pgdata

TZ=America/Los_Angeles

IMMICH_VERSION=release

# Generate with: openssl rand -base64 24
# Use only A-Za-z0-9 — no special characters or spaces.
DB_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_VALUE

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
